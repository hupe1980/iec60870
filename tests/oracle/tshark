#!/bin/sh
set -eu
run() {
    docker run --rm -i --network=none --read-only --cap-drop=ALL \
        --security-opt=no-new-privileges --user 65534:65534 "$IEC60870_ORACLE_IMAGE" "$@"
}
case "$1" in
    --version) run --version ;;
    -r)
        capture=$2
        shift 2
        run -n -r - "$@" < "$capture"
        ;;
    *) exit 2 ;;
esac
