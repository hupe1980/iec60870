# lib60870-C as the interop peer of the iec60870 station tests (tests/interop_station.rs).
#
# The same pinned commit as the link harness (Dockerfile). The library is GPL-3 and is never
# vendored: it is cloned here when the image is built. station_client.c and station_server.c
# (MIT, part of this crate's tests) link against it.
FROM debian:bookworm-slim

# The commit is pinned in one place, tests/interop/LIB60870_COMMIT, and passed by the test
# harness as a build argument; there is deliberately no default here.
ARG LIB60870_COMMIT

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN test -n "$LIB60870_COMMIT" \
 && git clone https://github.com/mz-automation/lib60870.git /opt/lib60870 \
 && cd /opt/lib60870 \
 && git checkout --detach "$LIB60870_COMMIT" \
 && test "$(git rev-parse HEAD)" = "$LIB60870_COMMIT" \
 && make -C lib60870-C -j"$(nproc)"

COPY station_client.c station_server.c /opt/peer/
RUN cd /opt/lib60870/lib60870-C \
 && for p in station_client station_server; do \
      gcc -O1 -g -Wall -o /usr/local/bin/$(echo $p | tr _ -) /opt/peer/$p.c \
        -DINTEROP_FILES -Isrc/file-service -Isrc/inc/internal -Iconfig src/file-service/file_server.c -Isrc/inc/api -Isrc/hal/inc -Isrc/tls build/liblib60870.a -lpthread || exit 1; \
    done
